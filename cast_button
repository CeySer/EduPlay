    <!-- Einstellungen-Button (bestehend) -->
    <button onclick="openDrawer()" title="Einstellungen" aria-label="Einstellungen"
        class="w-10 h-10 rounded-xl hub-bar text-lg text-gray-400">
        ☰
    </button>
</div>