    <button onclick="toggleCast()" id="castButton"
        class="w-10 h-10 rounded-xl hub-bar text-lg text-gray-400 hover:text-white transition-all"
        title="Mit Fernseher verbinden">
        🖥️
    </button>
    <!-- Ton-Button (bestehend) -->
    <button onclick="toggleSound()" title="Ton an/aus" class="w-10 h-10 rounded-xl hub-bar text-lg">
